<Window x:Class="PixelBatch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="PixelBatch — Xử lý ảnh hàng loạt" Width="1380" Height="940" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F3F6F3" FontFamily="Segoe UI" FontSize="12" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" DragLeave="Window_DragLeave" Closing="Window_Closing" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
  <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}" /><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ExportCommand}" /><KeyBinding Key="F1" Command="{Binding ShowGuideCommand}" /></Window.InputBindings>
  <Border BorderBrush="#DCE5DD" BorderThickness="1">
    <Grid x:Name="RootGrid" Background="#F3F6F3">
      <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="100" /><RowDefinition Height="*" /><RowDefinition Height="104" /></Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#17382E">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="23,0,0,0" VerticalAlignment="Center">
          <Grid Width="22" Height="22" Margin="0,0,10,0"><Rectangle Width="9" Height="9" Fill="#B7ED8D" HorizontalAlignment="Left" VerticalAlignment="Top" RadiusX="2" RadiusY="2" /><Rectangle Width="9" Height="9" Fill="#83BC66" HorizontalAlignment="Right" VerticalAlignment="Top" RadiusX="2" RadiusY="2" /><Rectangle Width="9" Height="9" Fill="#83BC66" HorizontalAlignment="Left" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" /><Rectangle Width="9" Height="9" Fill="#B7ED8D" HorizontalAlignment="Right" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" /></Grid>
          <TextBlock Text="PixelBatch" Foreground="White" FontSize="16" FontWeight="SemiBold" />
          <Border Background="#2A4A3D" CornerRadius="4" Padding="7,3" Margin="12,0,0,0"><TextBlock Text="WINDOWS" Foreground="#B6D2BE" FontSize="9" FontWeight="SemiBold" /></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
          <Button x:Name="GuideButton" Click="ShowGuide_Click" Style="{StaticResource QuietButton}" FontSize="11" Padding="11,7" Margin="0,0,15,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Hướng dẫn và 3 ảnh mẫu · F1" AutomationProperties.Name="Hướng dẫn sử dụng"><TextBlock Text="Hướng dẫn" Foreground="#D8E9DB" /></Button>
          <Ellipse Width="5" Height="5" Fill="#A7DF8E" Margin="0,0,7,0" /><TextBlock Text="Xử lý trên thiết bị" Foreground="#C6DACB" FontSize="11" VerticalAlignment="Center" Margin="0,0,22,0" />
          <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Thu nhỏ" AutomationProperties.Name="Thu nhỏ"><Path Data="M 0,5 L 12,5" Stroke="#C8DBD1" StrokeThickness="1.2" /></Button>
          <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Phóng to / Khôi phục" AutomationProperties.Name="Phóng to"><Rectangle Width="10" Height="10" Stroke="#C8DBD1" StrokeThickness="1.2" /></Button>
          <Button Style="{StaticResource CaptionButton}" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Đóng" AutomationProperties.Name="Đóng"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#C8DBD1" StrokeThickness="1.2" /></Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="HeaderPanel" Grid.Row="1" Margin="26,19,26,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Xử lý ảnh hàng loạt" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Ảnh nhẹ hơn. Đúng kích thước. Sẵn sàng chia sẻ." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button x:Name="AddFolderButton" Content="Thêm thư mục" Click="AddFolder_Click" Margin="0,0,9,0" ToolTip="Thêm ảnh từ thư mục; bật Đọc cả thư mục con để quét các nhánh bên trong" />
          <Button x:Name="AddButton" Grid.Column="1" Click="AddFiles_Click" Style="{StaticResource PrimaryButton}" Padding="17,11" ToolTip="Chọn nhiều ảnh · Ctrl+O"><StackPanel Orientation="Horizontal"><Path Data="M 6,0 L 6,12 M 0,6 L 12,6" Stroke="White" StrokeThickness="1.6" Width="12" Height="12" Margin="0,0,9,0" /><TextBlock Text="Thêm ảnh" Foreground="White" /></StackPanel></Button>
          <CheckBox x:Name="IncludeSubfoldersCheck" Grid.Row="1" Grid.ColumnSpan="2" Content="Đọc cả thư mục con" FontSize="10" Margin="0,5,0,0" ToolTip="Áp dụng cho lần thêm thư mục tiếp theo, gồm kéo/thả. Bỏ qua thư mục liên kết và thư mục kết quả nằm bên trong nguồn." />
        </Grid>
      </Grid>

      <Grid x:Name="WorkspacePanel" Grid.Row="2" Margin="26,0,26,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="346" /></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="230" /><RowDefinition Height="17" /><RowDefinition Height="213" /></Grid.RowDefinitions>
          <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="53" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="45" /></Grid.RowDefinitions>
              <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Xem trước" FontWeight="SemiBold" FontSize="13" /><Border Background="#EDF7EE" CornerRadius="4" Padding="6,3" Margin="9,0,0,0"><TextBlock x:Name="PreviewFormatLabel" Text="WEBP" Foreground="#207C55" FontSize="9" FontWeight="Bold" /></Border></StackPanel>
                <Border Grid.Column="1" Background="#F1F4F1" CornerRadius="7" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="ResultTab" Content="Kết quả" GroupName="Preview" Style="{StaticResource Segment}" IsChecked="True" Checked="PreviewTab_Checked" /><RadioButton x:Name="OriginalTab" Content="Ảnh gốc" GroupName="Preview" Style="{StaticResource Segment}" Checked="PreviewTab_Checked" /><RadioButton x:Name="CompareTab" Content="So sánh" GroupName="Preview" Style="{StaticResource Segment}" Checked="PreviewTab_Checked" ToolTip="So sánh với ảnh gốc đã cắt/thu về cùng khung, trước nén và watermark" /></StackPanel></Border>
              </Grid>

              <Border Grid.Row="1" Margin="16,0" CornerRadius="7" ClipToBounds="True" Background="#F6F8F4" BorderBrush="#E9EEE7" BorderThickness="1">
                <Grid>
                  <Border x:Name="Checkerboard" Visibility="Collapsed"><Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#F5F6F3" Geometry="M0,0 H20 V20 H0 Z" /><GeometryDrawing Brush="#E9EDE6" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z" /></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Border.Background></Border>
                  <ScrollViewer x:Name="PreviewViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" SizeChanged="PreviewViewport_SizeChanged" ScrollChanged="PreviewViewport_ScrollChanged">
                    <Grid x:Name="PreviewCanvas" Background="Transparent" SizeChanged="PreviewCanvas_SizeChanged" MouseLeftButtonDown="PreviewCanvas_MouseDown" MouseMove="PreviewCanvas_MouseMove" MouseLeftButtonUp="PreviewCanvas_MouseUp" LostMouseCapture="PreviewCanvas_LostMouseCapture">
                      <Grid x:Name="ComparisonAfterLayer" IsHitTestVisible="False"><Image x:Name="PreviewImage" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality" /></Grid>
                      <Grid x:Name="ComparisonBeforeLayer" IsHitTestVisible="False" Visibility="Collapsed"><Image x:Name="ComparisonBeforeImage" Stretch="Uniform" Margin="15" RenderOptions.BitmapScalingMode="HighQuality" /></Grid>
                      <Canvas IsHitTestVisible="False"><Border x:Name="ComparisonDivider" Visibility="Collapsed" Width="2" Background="White" BorderBrush="#207C55" BorderThickness="1" /></Canvas>
                    </Grid>
                  </ScrollViewer>
                  <Border x:Name="PreviewTargetBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="6" Padding="10,7" Background="#EDF7EE"><TextBlock x:Name="PreviewTargetLabel" FontSize="11" TextWrapping="Wrap" MaxWidth="460" /></Border>
                  <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25,15">
                    <Grid Width="120" Height="90" Margin="0,0,0,19">
                      <Border Width="72" Height="65" Background="#DCEAD8" CornerRadius="8" RenderTransformOrigin="0.5,0.5" Margin="0,0,22,12"><Border.RenderTransform><RotateTransform Angle="-13" /></Border.RenderTransform></Border>
                      <Border Width="78" Height="68" Background="White" BorderBrush="#BED1B6" BorderThickness="1" CornerRadius="8" Margin="17,15,0,0"><Grid Margin="8"><Ellipse Width="11" Height="11" Fill="#D5B873" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" /><Path Data="M0,42 L21,15 L37,31 L48,20 L60,42 Z" Fill="#7CA983" Stretch="Uniform" VerticalAlignment="Bottom" Height="35" /></Grid></Border>
                      <Border Width="28" Height="28" CornerRadius="14" Background="#207C55" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"><Path Data="M8,14 H20 M14,8 V20" Stroke="White" StrokeThickness="1.6" /></Border>
                    </Grid>
                    <TextBlock Text="Thả ảnh vào đây để bắt đầu" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Hoặc chọn Thêm ảnh để mở nhiều tệp cùng lúc" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11" />
                    <TextBlock Text="JPG · PNG · WEBP · BMP" HorizontalAlignment="Center" Foreground="#98A28F" Margin="0,17,0,0" FontSize="10" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border x:Name="PreviewLoading" Visibility="Collapsed" Background="#DFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" CornerRadius="6" Padding="12,8"><StackPanel Orientation="Horizontal"><ProgressBar Width="34" Height="3" IsIndeterminate="True" Foreground="#207C55" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock Text="Đang tạo bản xem trước…" FontSize="11" /></StackPanel></Border>
                </Grid>
              </Border>
              <Grid x:Name="CompareControls" Grid.Row="2" Margin="20,7,20,0" Visibility="Collapsed" ToolTip="Bên trái: ảnh gốc cùng vùng cắt và kích thước, trước nén và watermark. Bên phải: kết quả thực tế."><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Gốc cùng khung" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource Muted}" /><Slider x:Name="CompareSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Margin="14,0" ValueChanged="CompareSlider_Changed" AutomationProperties.Name="Vị trí thanh so sánh trước sau" /><TextBlock Grid.Column="2" Text="Kết quả" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource Muted}" /></Grid>
              <Grid Grid.Row="3" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PreviewInfoLabel" Text="Chọn một ảnh để xem thay đổi ngay tại đây" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><Border x:Name="SavingsBadge" Grid.Column="1" Background="#EDF7EE" CornerRadius="4" Padding="7,4" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="SavingsLabel" Foreground="#207C55" FontSize="10" FontWeight="SemiBold" /></Border><Border Grid.Column="2" Background="#F1F4F1" CornerRadius="5" Padding="2" Margin="9,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="FitZoomOption" Content="Vừa khung" IsChecked="True" GroupName="Zoom" Style="{StaticResource Segment}" FontSize="10" Checked="Zoom_Checked" /><RadioButton x:Name="NativeZoomOption" Content="100%" GroupName="Zoom" Style="{StaticResource Segment}" FontSize="10" Checked="Zoom_Checked" ToolTip="1 điểm ảnh của ảnh = 1 điểm ảnh màn hình. Cuộn dọc/ngang để xem vùng khác." /></StackPanel></Border></Grid>
            </Grid>
          </Border>

          <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid><Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Danh sách ảnh" FontWeight="SemiBold" /><TextBlock x:Name="CountLabel" Text="0 ảnh" Foreground="{StaticResource Muted}" Margin="9,0,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RetryButton" Content="Thử lại lỗi (0)" Click="Retry_Click" Style="{StaticResource QuietButton}" Padding="6,4" FontSize="10" IsEnabled="False" Margin="0,0,8,0" ToolTip="Chỉ xuất lại các tệp bị lỗi bằng thiết lập và thư mục lưu hiện tại. Giữ cỡ xuất nhiều kích thước và số thứ tự của lần trước. Không gồm ảnh không đọc được hoặc tệp chưa chạy do đã dừng." /><Button x:Name="ClearButton" Content="Xóa danh sách" Style="{StaticResource QuietButton}" Click="Clear_Click" Padding="6,4" FontSize="10" IsEnabled="False" /></StackPanel></Grid>
              <TextBlock x:Name="EmptyQueueLabel" Grid.Row="1" Text="Các ảnh đã thêm sẽ xuất hiện ở đây." Foreground="#94A092" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ListBox x:Name="FileList" Grid.Row="1" ItemsSource="{Binding Files}" SelectionChanged="FileList_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="8,0,8,7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowSurface" CornerRadius="7" Background="Transparent" Padding="8,7"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#EDF7EE" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#CDDFCA" /><Setter TargetName="RowSurface" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" CornerRadius="5" Background="#E7EDE3" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,9,0"><TextBlock Text="{Binding DisplayPath}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" /><TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" FontSize="10" Margin="0,0,7,0" MaxWidth="110" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}" />
                  <Button Grid.Column="3" Tag="{Binding}" Click="RemoveFile_Click" Style="{StaticResource QuietButton}" Padding="8" ToolTip="Bỏ ảnh khỏi danh sách" AutomationProperties.Name="Bỏ ảnh khỏi danh sách"><Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="#8C998C" StrokeThickness="1.2" Width="7" Height="7" /></Button>
                </Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="53" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="19,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Thiết lập xuất ảnh" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="ResetButton" Grid.Column="1" Content="Đặt lại" Style="{StaticResource QuietButton}" Padding="6,5" FontSize="10" Click="Reset_Click" /></Grid>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="19,0,19,18">
              <StackPanel x:Name="SettingsPanel">
                <TextBlock Text="Bắt đầu nhanh" Style="{StaticResource FieldLabel}" />
                <UniformGrid Columns="3" Margin="0,0,0,12"><Button Content="Gọn nhẹ" Tag="small" Click="Preset_Click" FontSize="10" Padding="5,8" Margin="0,0,5,0" Background="#F5F8F2" /><Button Content="Cân bằng" Tag="balanced" Click="Preset_Click" FontSize="10" Padding="5,8" Margin="0,0,5,0" Background="#F5F8F2" /><Button Content="Chi tiết" Tag="detail" Click="Preset_Click" FontSize="10" Padding="5,8" Background="#F5F8F2" /></UniformGrid>
                <Expander x:Name="PersonalPresetsExpander" Header="Preset của bạn" FontSize="11" Margin="0,0,0,20">
                  <StackPanel Margin="0,10,0,0">
                    <ComboBox x:Name="SavedPresetCombo" DisplayMemberPath="Name" SelectionChanged="SavedPreset_SelectionChanged" AutomationProperties.Name="Preset đã lưu" />
                    <Grid Margin="0,7,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="ApplyPresetButton" Content="Áp dụng" Click="ApplySavedPreset_Click" FontSize="11" Padding="10,7" IsEnabled="False" /><Button x:Name="DeletePresetButton" Grid.Column="1" Content="Xóa" Click="DeletePreset_Click" FontSize="11" Padding="14,7" Margin="7,0,0,0" IsEnabled="False" /></Grid>
                    <TextBlock Text="Tên preset mới / cần cập nhật" Style="{StaticResource FieldLabel}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="PresetNameInput" MaxLength="48" AutomationProperties.Name="Tên preset" /><Button Grid.Column="1" Content="Lưu" Click="SavePreset_Click" Padding="14,7" Margin="7,0,0,0" FontSize="11" /></Grid>
                    <TextBlock Text="Lưu cả dung lượng, watermark, các cỡ ảnh và ZIP. Nhập cùng tên để cập nhật." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </Expander>

                <TextBlock Text="01   Định dạng &amp; chất lượng" Style="{StaticResource SectionLabel}" />
                <Border Background="#F0F4EE" CornerRadius="7" Padding="3" Margin="0,0,0,15"><UniformGrid Columns="3"><RadioButton x:Name="WebpOption" Content="WebP" GroupName="Format" Style="{StaticResource Segment}" IsChecked="True" Checked="Settings_Changed" /><RadioButton x:Name="JpegOption" Content="JPG" GroupName="Format" Style="{StaticResource Segment}" Checked="Settings_Changed" /><RadioButton x:Name="PngOption" Content="PNG" GroupName="Format" Style="{StaticResource Segment}" Checked="Settings_Changed" /></UniformGrid></Border>
                <Grid><TextBlock x:Name="QualityFieldLabel" Text="Chất lượng" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="QualityValueLabel" Text="82%" HorizontalAlignment="Right" Foreground="#207C55" FontWeight="SemiBold" FontSize="11" /></Grid>
                <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="82" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,2,0,5" AutomationProperties.Name="Chất lượng ảnh" />
                <TextBlock x:Name="QualityHintLabel" Text="Cân bằng giữa độ nét và dung lượng." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                <CheckBox x:Name="TargetSizeCheck" Content="Nén theo dung lượng mục tiêu" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,13,0,0" />
                <StackPanel x:Name="TargetSizePanel" Visibility="Collapsed" Margin="0,10,0,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tối đa / ảnh (KB)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TargetKbInput" Text="200" MaxLength="6" TextChanged="Input_Changed" AutomationProperties.Name="Dung lượng mục tiêu KB" /></StackPanel><StackPanel x:Name="MinimumQualityPanel" Grid.Column="2"><TextBlock Text="Chất lượng tối thiểu" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MinimumQualityInput" Text="40" MaxLength="3" TextChanged="Input_Changed" AutomationProperties.Name="Chất lượng tối thiểu" /></StackPanel></Grid>
                  <TextBlock x:Name="TargetHintLabel" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel x:Name="JpegBackgroundPanel" Visibility="Collapsed" Margin="0,11,0,0"><TextBlock Text="Nền khi ảnh có vùng trong suốt" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="JpegBackgroundCombo" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Trắng" /><ComboBoxItem Content="Đen" /></ComboBox></StackPanel>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,21,0,19" />

                <TextBlock Text="02   Kích thước" Style="{StaticResource SectionLabel}" />
                <CheckBox x:Name="MultiSizeCheck" Content="Xuất nhiều kích thước cùng lúc" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,12" />
                <StackPanel x:Name="SingleSizePanel">
                <ComboBox x:Name="ResizeCombo" SelectedIndex="0" SelectionChanged="Settings_Changed" Margin="0,0,0,12"><ComboBoxItem Content="Giới hạn chiều rộng &amp; cao" /><ComboBoxItem Content="Giữ kích thước gốc" /><ComboBoxItem Content="Theo phần trăm" /></ComboBox>
                <Grid x:Name="FitPanel" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rộng tối đa (px)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WidthInput" Text="1920" TextChanged="Input_Changed" AutomationProperties.Name="Chiều rộng tối đa" /></StackPanel><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9" Foreground="#9AA597" /><StackPanel Grid.Column="2"><TextBlock Text="Cao tối đa (px)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="HeightInput" Text="1920" TextChanged="Input_Changed" AutomationProperties.Name="Chiều cao tối đa" /></StackPanel></Grid>
                <StackPanel x:Name="PercentagePanel" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="Tỉ lệ so với ảnh gốc (%)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PercentageInput" Text="100" TextChanged="Input_Changed" AutomationProperties.Name="Tỉ lệ phần trăm" /></StackPanel>
                </StackPanel>
                <StackPanel x:Name="MultiSizePanel" Visibility="Collapsed">
                  <ItemsControl x:Name="SizeList" ItemsSource="{Binding OutputSizes}" Margin="0,0,0,9"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="#F5F8F2" CornerRadius="5" Padding="10,7"><TextBlock Text="{Binding Label}" FontSize="11" /></Border><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSize_Click" Padding="10,4" Margin="5,0,0,0" ToolTip="Bỏ kích thước này" AutomationProperties.Name="Bỏ kích thước" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rộng tối đa (px)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SizeWidthInput" Text="1200" MaxLength="5" AutomationProperties.Name="Chiều rộng cỡ mới" /></StackPanel><TextBlock Grid.Column="1" Text="×" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,9" /><StackPanel Grid.Column="2"><TextBlock Text="Cao tối đa (px)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SizeHeightInput" Text="1200" MaxLength="5" AutomationProperties.Name="Chiều cao cỡ mới" /></StackPanel><Button Grid.Column="3" Content="+" Click="AddSize_Click" Padding="10,8" Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="Thêm cỡ ảnh, tối đa 6 cỡ" AutomationProperties.Name="Thêm kích thước" /></Grid>
                  <TextBlock Text="Cỡ xem trước" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="PreviewSizeCombo" ItemsSource="{Binding OutputSizes}" DisplayMemberPath="Label" SelectedIndex="0" SelectionChanged="Settings_Changed" Margin="0,0,0,9" AutomationProperties.Name="Kích thước xem trước" />
                </StackPanel>
                <TextBlock x:Name="AspectHintLabel" Text="Luôn giữ tỉ lệ ảnh, vừa trong khung đã chọn." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,9" />
                <CheckBox x:Name="AllowUpscaleCheck" Content="Cho phép phóng lớn ảnh nhỏ" Checked="Settings_Changed" Unchecked="Settings_Changed" />
                <Expander x:Name="TransformExpander" Header="Xoay &amp; lật ảnh" FontSize="11" Margin="0,15,0,0">
                  <StackPanel Margin="0,10,0,0">
                    <ComboBox x:Name="RotationCombo" SelectedIndex="0" SelectionChanged="Settings_Changed" AutomationProperties.Name="Góc xoay ảnh"><ComboBoxItem Content="Không xoay thêm" /><ComboBoxItem Content="Xoay phải 90°" /><ComboBoxItem Content="Xoay 180°" /><ComboBoxItem Content="Xoay trái 90°" /></ComboBox>
                    <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="FlipHorizontalCheck" Content="Lật ngang" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,18,0" /><CheckBox x:Name="FlipVerticalCheck" Content="Lật dọc" Checked="Settings_Changed" Unchecked="Settings_Changed" /></WrapPanel>
                    <TextBlock Text="Xoay rồi lật, sau đó cắt và đổi kích thước. Áp dụng cho cả lô và mọi cỡ xuất." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </Expander>
                <TextBlock Text="Cắt theo tỉ lệ" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" />
                <ComboBox x:Name="CropCombo" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Không cắt ảnh" /><ComboBoxItem Content="Vuông · 1:1" /><ComboBoxItem Content="Dọc · 4:5" /><ComboBoxItem Content="Ngang · 16:9" /><ComboBoxItem Content="Dọc · 9:16" /><ComboBoxItem Content="Tỉ lệ tùy chỉnh" /></ComboBox>
                <StackPanel x:Name="CropOptionsPanel" Visibility="Collapsed" Margin="0,11,0,0">
                  <Grid x:Name="CustomCropPanel" Visibility="Collapsed" Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tỉ lệ rộng" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CropWidthInput" Text="1" MaxLength="4" TextChanged="Input_Changed" AutomationProperties.Name="Tỉ lệ cắt chiều rộng" /></StackPanel><TextBlock Grid.Column="1" Text=":" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9" /><StackPanel Grid.Column="2"><TextBlock Text="Tỉ lệ cao" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CropHeightInput" Text="1" MaxLength="4" TextChanged="Input_Changed" AutomationProperties.Name="Tỉ lệ cắt chiều cao" /></StackPanel></Grid>
                  <Grid><TextBlock Text="Vùng giữ ngang · trái → phải" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="CropHorizontalLabel" Text="50%" HorizontalAlignment="Right" FontSize="10" Foreground="#207C55" /></Grid><Slider x:Name="CropHorizontalSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" AutomationProperties.Name="Vị trí cắt ngang" />
                  <Grid Margin="0,8,0,0"><TextBlock Text="Vùng giữ dọc · trên → dưới" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="CropVerticalLabel" Text="50%" HorizontalAlignment="Right" FontSize="10" Foreground="#207C55" /></Grid><Slider x:Name="CropVerticalSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" AutomationProperties.Name="Vị trí cắt dọc" />
                  <TextBlock Text="Cắt trước khi đổi kích thước, không kéo méo. Vùng giữ và tỉ lệ cắt áp dụng cho cả lô, gồm mọi cỡ xuất." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,21,0,19" />

                <TextBlock Text="03   Watermark" Style="{StaticResource SectionLabel}" />
                <ComboBox x:Name="WatermarkCombo" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Không thêm watermark" /><ComboBoxItem Content="Chữ / tên thương hiệu" /><ComboBoxItem Content="Logo từ ảnh" /></ComboBox>
                <StackPanel x:Name="WatermarkOptionsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                  <TextBox x:Name="WatermarkTextInput" Text="© PixelBatch" MaxLength="160" TextChanged="Input_Changed" Margin="0,0,0,10" AutomationProperties.Name="Nội dung watermark" />
                  <Button x:Name="LogoButton" Content="Chọn ảnh logo…" Click="ChooseLogo_Click" Visibility="Collapsed" Margin="0,0,0,10" />
                  <CheckBox x:Name="RepeatWatermarkCheck" Content="Lặp chữ phủ toàn ảnh" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,12" />
                  <StackPanel x:Name="RepeatWatermarkPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <Grid><TextBlock Text="Góc nghiêng" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="WatermarkAngleLabel" Text="-30°" HorizontalAlignment="Right" Foreground="#207C55" FontSize="11" /></Grid><Slider x:Name="WatermarkAngleSlider" Minimum="-90" Maximum="90" Value="-30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" AutomationProperties.Name="Góc nghiêng watermark" />
                    <Grid Margin="0,9,0,0"><TextBlock Text="Khoảng cách giữa chữ" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="WatermarkSpacingLabel" Text="100%" HorizontalAlignment="Right" Foreground="#207C55" FontSize="11" /></Grid><Slider x:Name="WatermarkSpacingSlider" Minimum="25" Maximum="300" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" AutomationProperties.Name="Khoảng cách watermark lặp" />
                  </StackPanel>
                  <ComboBox x:Name="PositionCombo" SelectedIndex="0" SelectionChanged="Settings_Changed" Margin="0,0,0,12"><ComboBoxItem Content="Góc dưới bên phải" /><ComboBoxItem Content="Góc dưới bên trái" /><ComboBoxItem Content="Góc trên bên phải" /><ComboBoxItem Content="Góc trên bên trái" /><ComboBoxItem Content="Chính giữa" /></ComboBox>
                  <Grid><TextBlock Text="Độ hiện" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="OpacityValueLabel" Text="65%" HorizontalAlignment="Right" FontSize="11" Foreground="#207C55" /></Grid><Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="65" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,0,0,10" AutomationProperties.Name="Độ hiện watermark" />
                  <Grid><TextBlock Text="Kích thước" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="WatermarkSizeLabel" Text="5%" HorizontalAlignment="Right" FontSize="11" Foreground="#207C55" /></Grid><Slider x:Name="WatermarkSizeSlider" Minimum="1" Maximum="20" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,0,0,10" AutomationProperties.Name="Kích thước watermark" />
                  <ComboBox x:Name="WatermarkColorCombo" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Chữ trắng" /><ComboBoxItem Content="Chữ đen" /></ComboBox>
                </StackPanel>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,21,0,15" />
                <Expander x:Name="NamingExpander" Header="04   Tên tệp &amp; gói ZIP" FontSize="11" Foreground="{StaticResource Ink}">
                  <StackPanel Margin="0,13,0,3">
                    <ComboBox x:Name="NamingCombo" SelectedIndex="0" SelectionChanged="Settings_Changed" Margin="0,0,0,10"><ComboBoxItem Content="Giữ tên gốc + hậu tố" /><ComboBoxItem Content="Tên theo mẫu / đánh số" /><ComboBoxItem Content="Thay một phần tên cũ" /></ComboBox>
                    <StackPanel x:Name="SuffixPanel"><TextBlock Text="Thêm vào cuối tên ảnh" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SuffixInput" Text="-pixelbatch" MaxLength="60" TextChanged="Input_Changed" AutomationProperties.Name="Hậu tố tên tệp" /></StackPanel>
                    <StackPanel x:Name="TemplateNamingPanel" Visibility="Collapsed">
                      <TextBlock Text="Mẫu tên ảnh xuất" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NameTemplateInput" Text="san-pham-{n:000}" MaxLength="160" TextChanged="Input_Changed" AutomationProperties.Name="Mẫu tên ảnh xuất" />
                      <TextBlock Text="{}{name} tên gốc · {sku} mã SP · {n:000} số thứ tự · {width}/{height} số px thực tế" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,10" />
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mã sản phẩm" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SkuInput" MaxLength="80" TextChanged="Input_Changed" AutomationProperties.Name="Mã sản phẩm" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Số bắt đầu" Style="{StaticResource FieldLabel}" /><TextBox x:Name="StartNumberInput" Text="1" MaxLength="6" TextChanged="Input_Changed" AutomationProperties.Name="Số thứ tự bắt đầu" /></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel x:Name="ReplaceNamingPanel" Visibility="Collapsed"><TextBlock Text="Phần tên cần tìm (không phân biệt hoa/thường)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="FindNameInput" MaxLength="160" TextChanged="Input_Changed" AutomationProperties.Name="Phần tên cần thay" /><TextBlock Text="Thay bằng (để trống để xóa)" Style="{StaticResource FieldLabel}" Margin="0,9,0,6" /><TextBox x:Name="ReplaceNameInput" MaxLength="160" TextChanged="Input_Changed" AutomationProperties.Name="Phần tên mới" /></StackPanel>
                    <Border Background="#F5F8F2" CornerRadius="5" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="TÊN XUẤT CỦA ẢNH ĐANG CHỌN" FontSize="9" Foreground="{StaticResource Muted}" /><TextBlock x:Name="OutputNameLabel" Text="Thêm ảnh để xem tên kết quả" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,5,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StackPanel></Border>
                    <TextBlock Text="Chỉ đặt tên cho ảnh xuất. Số thứ tự theo danh sách, giữ cùng số ở mọi cỡ. Tên trùng sẽ thêm (2), (3)…" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <CheckBox x:Name="PreserveFoldersCheck" Content="Giữ cấu trúc thư mục nguồn" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,13,0,0" />
                    <TextBlock Text="Giữ tên thư mục đã thêm và các nhánh con. Với nhiều cỡ: cỡ ảnh → thư mục nguồn → ảnh. Ảnh thêm bằng Thêm ảnh nằm trực tiếp trong thư mục kết quả." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <CheckBox x:Name="ZipCheck" Content="Tạo thêm một tệp ZIP chứa kết quả" Margin="0,13,0,0" />
                  </StackPanel>
                </Expander>
                <Border Background="#F5F8F2" CornerRadius="6" Padding="10" Margin="0,17,0,0"><TextBlock Text="Ảnh gốc luôn được giữ nguyên. Thông tin vị trí và metadata được loại bỏ khỏi ảnh xuất." FontSize="10" Foreground="#7A8972" TextWrapping="Wrap" LineHeight="16" /></Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border x:Name="DropOverlay" Grid.ColumnSpan="3" Background="#E6EDF7EE" BorderBrush="#207C55" BorderThickness="2" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Thả để thêm ảnh" FontSize="27" FontWeight="SemiBold" Foreground="#207C55" /><TextBlock Text="Bạn có thể thả nhiều ảnh hoặc cả thư mục." Margin="0,10,0,0" Foreground="#50765A" /></StackPanel></Border>
      </Grid>

      <Border x:Name="FooterPanel" Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid Margin="26,12,26,12"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="25" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid Margin="0,0,25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,19,0"><TextBlock Text="THƯ MỤC LƯU" FontSize="9" FontWeight="SemiBold" Foreground="#85947F" /><TextBlock x:Name="TotalLabel" Text="0 ảnh · 0 KB" FontSize="11" Margin="0,5,0,0" /></StackPanel><TextBox x:Name="OutputDirectoryInput" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Background="#F6F8F4" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Thư mục lưu kết quả" /><Button x:Name="BrowseButton" Grid.Column="2" Content="Chọn…" Click="BrowseOutput_Click" Margin="8,0,0,0" VerticalAlignment="Center" /><Button x:Name="OpenOutputButton" Grid.Column="3" Content="Mở" Click="OpenOutput_Click" Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="Mở thư mục kết quả" /></Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CancelButton" Content="Dừng" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,10,0" /><Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Export_Click" MinWidth="193" Height="43" Padding="20,10" FontSize="13" ToolTip="Xuất toàn bộ ảnh · Ctrl+Enter"><StackPanel Orientation="Horizontal"><Path Data="M6,0 V9 M2,5 L6,9 L10,5 M0,10 V14 H12 V10" Width="12" Height="14" Stroke="White" StrokeThickness="1.5" Margin="0,0,10,0" /><TextBlock x:Name="ExportButtonLabel" Text="Xuất ảnh" Foreground="White" /></StackPanel></Button></StackPanel>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="Sẵn sàng · Thêm ảnh để bắt đầu" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><ProgressBar x:Name="BatchProgress" Grid.Column="1" Height="4" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" Foreground="#207C55" Background="#EDF1E9" BorderThickness="0" /></Grid>
        </Grid>
      </Border>
      <Grid x:Name="GuideOverlay" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="20" Background="#DDF3F6F3" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Guide_PreviewKeyDown" AutomationProperties.Name="Hướng dẫn bắt đầu">
        <Border x:Name="GuideCard" MaxWidth="744" Margin="28" VerticalAlignment="Center" Background="White" CornerRadius="16" BorderBrush="#D7E4D7" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,25">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#EDF7EE" CornerRadius="5" Padding="9,5"><TextBlock Text="BẮT ĐẦU CÙNG PIXELBATCH" Foreground="#207C55" FontSize="10" FontWeight="SemiBold" /></Border></StackPanel>
                <Button x:Name="GuideCloseButton" Grid.Column="1" Content="×" Click="CloseGuide_Click" Style="{StaticResource QuietButton}" FontSize="21" Padding="9,0" ToolTip="Đóng hướng dẫn · Esc" AutomationProperties.Name="Đóng hướng dẫn" />
              </Grid>
              <TextBlock Text="Mẻ ảnh đầu tiên trong 3 bước" FontSize="25" FontWeight="SemiBold" Margin="0,18,0,7" TextWrapping="Wrap" />
              <TextBlock Text="Nén, đổi kích thước và xuất cả lô ngay trên máy của bạn." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
              <Border Background="#F6F8F4" CornerRadius="10" Padding="18,16" Margin="0,22,0,0">
                <StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="#E1EEDE" CornerRadius="13" VerticalAlignment="Top"><TextBlock Text="1" Foreground="#207C55" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Thêm ảnh của bạn" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Kéo thả ảnh hoặc thư mục vào app. Có thể chọn nhiều ảnh cùng lúc." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                  </Grid>
                  <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="#E1EEDE" CornerRadius="13" VerticalAlignment="Top"><TextBlock Text="2" Foreground="#207C55" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Chọn thiết lập và xem trước" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Bắt đầu bằng preset Cân bằng ở bên phải. Dùng So sánh để kiểm tra chất lượng; thêm watermark nếu cần." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                  </Grid>
                  <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="#E1EEDE" CornerRadius="13" VerticalAlignment="Top"><TextBlock Text="3" Foreground="#207C55" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="Chọn nơi lưu rồi xuất ảnh" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Bấm Chọn… ở thanh dưới để đổi thư mục, rồi bấm Xuất ảnh. Bấm Mở để xem kết quả; ảnh gốc luôn được giữ nguyên." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <WrapPanel Margin="0,23,0,0"><Button x:Name="GuideSampleButton" Click="GuideSample_Click" Style="{StaticResource PrimaryButton}" Padding="17,11" Margin="0,0,10,8"><TextBlock Text="Thử với 3 ảnh mẫu" Foreground="White" /></Button><Button x:Name="GuideOwnPhotosButton" Content="Dùng ảnh của tôi" Click="GuideOwnPhotos_Click" Padding="17,11" Margin="0,0,0,8" /></WrapPanel>
              <TextBlock Text="Ảnh mẫu được thêm vào danh sách, giữ nguyên ảnh và thiết lập hiện có. Mở lại hướng dẫn bất cứ lúc nào bằng F1." Foreground="{StaticResource Muted}" FontSize="10" LineHeight="16" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
